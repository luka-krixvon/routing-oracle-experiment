# ---- never commit: model weights / caches / data / outputs / temp ----
# Hugging Face caches & model weights / checkpoints
.cache/
huggingface/
hf_cache/
**/snapshots/
**/blobs/
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
checkpoints/

# generated on the GPU VM (send these back manually, do NOT git-commit)
data/
results/
logs/
*.npz
*.pkl
*.parquet
*.arrow

# python / env
__pycache__/
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/
.DS_Store

# ---- published paper artifacts (small; reproduce the tables from committed data) — DO commit ----
!artifacts/
!artifacts/**

# ---- GPQA anti-leak: the dataset's authors ask that questions/answers never be
# posted online in plaintext. Only subset_ids.json (hashes) is published;
# rebuild the plaintext locally with scripts/rebuild_gpqa_subset.py ----
artifacts/gpqa/subset.json
artifacts/**/*.local.json
artifacts/**/*.local.npz
